# ============================================================
# BankFlow — Root Environment Variables Reference
# Copy this to .env and fill in real values
# NEVER commit .env to Git
# ============================================================

# ─── Node ───────────────────────────────────────────────────
NODE_ENV=development

# ─── Redis ──────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=bankflow_redis_secret

# ─── Kafka ──────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092

# ─── RabbitMQ ───────────────────────────────────────────────
RABBITMQ_URL=amqp://bankflow:bankflow_rabbit_secret@localhost:5672/bankflow
RABBITMQ_USER=bankflow
RABBITMQ_PASS=bankflow_rabbit_secret

# ─── Neon PostgreSQL (Database-per-Service) ─────────────────
# Format: postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require
# Pooled URL  → used by all services at runtime (PgBouncer)
# Direct URL  → used ONLY for migrations (prisma migrate / sql scripts)

# auth-service
AUTH_DATABASE_URL=postgresql://USER:PASS@ep-xxx.neon.tech/auth_db?sslmode=require
AUTH_DATABASE_DIRECT_URL=postgresql://USER:PASS@ep-xxx-direct.neon.tech/auth_db?sslmode=require

# user-service
USER_DATABASE_URL=postgresql://USER:PASS@ep-xxx.neon.tech/user_db?sslmode=require
USER_DATABASE_DIRECT_URL=postgresql://USER:PASS@ep-xxx-direct.neon.tech/user_db?sslmode=require

# account-service
ACCOUNT_DATABASE_URL=postgresql://USER:PASS@ep-xxx.neon.tech/account_db?sslmode=require
ACCOUNT_DATABASE_DIRECT_URL=postgresql://USER:PASS@ep-xxx-direct.neon.tech/account_db?sslmode=require

# ledger-service
LEDGER_DATABASE_URL=postgresql://USER:PASS@ep-xxx.neon.tech/ledger_db?sslmode=require
LEDGER_DATABASE_DIRECT_URL=postgresql://USER:PASS@ep-xxx-direct.neon.tech/ledger_db?sslmode=require

# transaction-service
TRANSACTION_DATABASE_URL=postgresql://USER:PASS@ep-xxx.neon.tech/transaction_db?sslmode=require
TRANSACTION_DATABASE_DIRECT_URL=postgresql://USER:PASS@ep-xxx-direct.neon.tech/transaction_db?sslmode=require

# payment-service
PAYMENT_DATABASE_URL=postgresql://USER:PASS@ep-xxx.neon.tech/payment_db?sslmode=require
PAYMENT_DATABASE_DIRECT_URL=postgresql://USER:PASS@ep-xxx-direct.neon.tech/payment_db?sslmode=require

# beneficiary-service
BENEFICIARY_DATABASE_URL=postgresql://USER:PASS@ep-xxx.neon.tech/beneficiary_db?sslmode=require
BENEFICIARY_DATABASE_DIRECT_URL=postgresql://USER:PASS@ep-xxx-direct.neon.tech/beneficiary_db?sslmode=require

# bank-service
BANK_DATABASE_URL=postgresql://USER:PASS@ep-xxx.neon.tech/bank_db?sslmode=require
BANK_DATABASE_DIRECT_URL=postgresql://USER:PASS@ep-xxx-direct.neon.tech/bank_db?sslmode=require

# settlement-service
SETTLEMENT_DATABASE_URL=postgresql://USER:PASS@ep-xxx.neon.tech/settlement_db?sslmode=require
SETTLEMENT_DATABASE_DIRECT_URL=postgresql://USER:PASS@ep-xxx-direct.neon.tech/settlement_db?sslmode=require

# reconciliation-service
RECONCILIATION_DATABASE_URL=postgresql://USER:PASS@ep-xxx.neon.tech/reconciliation_db?sslmode=require
RECONCILIATION_DATABASE_DIRECT_URL=postgresql://USER:PASS@ep-xxx-direct.neon.tech/reconciliation_db?sslmode=require

# notification-service
NOTIFICATION_DATABASE_URL=postgresql://USER:PASS@ep-xxx.neon.tech/notification_db?sslmode=require
NOTIFICATION_DATABASE_DIRECT_URL=postgresql://USER:PASS@ep-xxx-direct.neon.tech/notification_db?sslmode=require

# ─── JWT ────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_minimum_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_minimum_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Service Ports ──────────────────────────────────────────
API_GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
USER_SERVICE_PORT=3002
ACCOUNT_SERVICE_PORT=3003
LEDGER_SERVICE_PORT=3004
TRANSACTION_SERVICE_PORT=3005
PAYMENT_SERVICE_PORT=3006
BENEFICIARY_SERVICE_PORT=3007
BANK_SERVICE_PORT=3008
SETTLEMENT_SERVICE_PORT=3009
RECONCILIATION_SERVICE_PORT=3010
NOTIFICATION_SERVICE_PORT=3011
PAYMENT_NETWORK_PORT=4000
EXTERNAL_BANK_PORT=4001
