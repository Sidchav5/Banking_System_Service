{
  "name": "bankflow",
  "version": "1.0.0",
  "description": "BankFlow — Distributed Banking & Payment Processing Platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*",
    "simulators/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"GATEWAY,AUTH,USER,ACCOUNT,LEDGER,TRANS,FRONTEND\" -c \"blue,green,magenta,yellow,red,cyan,gray\" \"npm run dev:gateway\" \"npm run dev:auth\" \"npm run dev:user\" \"npm run dev:account\" \"npm run dev:ledger\" \"npm run dev:transaction\" \"npm run dev:frontend\"",
    "dev:gateway": "npm run dev --workspace=@bankflow/api-gateway",
    "dev:auth": "npm run dev --workspace=@bankflow/auth-service",
    "dev:user": "npm run dev --workspace=@bankflow/user-service",
    "dev:account": "npm run dev --workspace=@bankflow/account-service",
    "dev:ledger": "npm run dev --workspace=@bankflow/ledger-service",
    "dev:transaction": "npm run dev --workspace=@bankflow/transaction-service",
    "dev:frontend": "npm run dev --workspace=@bankflow/frontend",
    "infra:up": "docker-compose up -d",
    "infra:down": "docker-compose down",
    "infra:logs": "docker-compose logs -f",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx --ignore-path .gitignore",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\" --ignore-path .gitignore",
    "typecheck": "tsc --noEmit --project tsconfig.base.json"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@types/node": "^20.16.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
