# API Gateway Environment Variables
# Copy to .env and fill in real values

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# CORS — comma separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173

# Redis (from docker-compose)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=bankflow_redis_secret

# JWT (must match auth-service)
JWT_ACCESS_SECRET=your_access_secret_minimum_32_characters_here

# Downstream Service URLs
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
ACCOUNT_SERVICE_URL=http://localhost:3003
LEDGER_SERVICE_URL=http://localhost:3004
TRANSACTION_SERVICE_URL=http://localhost:3005
PAYMENT_SERVICE_URL=http://localhost:3006
BENEFICIARY_SERVICE_URL=http://localhost:3007
BANK_SERVICE_URL=http://localhost:3008
SETTLEMENT_SERVICE_URL=http://localhost:3009
RECONCILIATION_SERVICE_URL=http://localhost:3010
NOTIFICATION_SERVICE_URL=http://localhost:3011

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10
